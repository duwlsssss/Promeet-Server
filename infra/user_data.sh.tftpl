#!/bin/bash
# EC2 최초 부팅 시 1회 실행: Docker, Nginx, certbot, AWS CLI 설치 + Nginx 블루/그린 기본 설정
set -euxo pipefail

export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y docker.io nginx certbot python3-certbot-nginx curl unzip jq

# AWS CLI v2 (ARM)
curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-aarch64.zip" -o /tmp/awscliv2.zip
unzip -q /tmp/awscliv2.zip -d /tmp
/tmp/aws/install
rm -rf /tmp/aws /tmp/awscliv2.zip
systemctl enable --now docker

# t4g.micro(1GB) 메모리 보완용 스왑 1GB
if [ ! -f /swapfile ]; then
  fallocate -l 1G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

mkdir -p /opt/promeet /etc/nginx/promeet

# 현재 트래픽을 받는 컨테이너 주소 (deploy.sh가 blue:3001 <-> green:3002로 바꿔 씀)
echo 'set $promeet_upstream http://127.0.0.1:3001;' > /etc/nginx/promeet/upstream.inc

cat > /etc/nginx/sites-available/promeet <<'NGINX'
server {
    listen 80;
    server_name ${domain};

    location / {
        include /etc/nginx/promeet/upstream.inc;
        proxy_pass $promeet_upstream;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }
}
NGINX

rm -f /etc/nginx/sites-enabled/default
ln -sf /etc/nginx/sites-available/promeet /etc/nginx/sites-enabled/promeet
nginx -t
systemctl enable --now nginx
systemctl reload nginx
